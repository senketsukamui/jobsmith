{
  "manifest_version": 3,
  "name": "Jobsmith",
  "version": "0.1.0",
  "description": "One-click job page capture for any job board. Clips the full page to Markdown.",

  "permissions": ["storage", "activeTab", "tabs", "scripting"],

  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Jobsmith"
  },

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content/clipper.js"],
      "run_at": "document_idle",
      "type": "module"
    }
  ],

  "host_permissions": ["http://127.0.0.1/*", "*://*/*"]
}
